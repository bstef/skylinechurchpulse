{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skylinechurchpulse",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "LOCAL_DEV": "false",
    "EMAIL_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "peacockengr.cloudflareaccess.com",
    "ACCESS_AUD": "2be643806834b2f6b30c25f6d111555a17866fcbcff44d1313ed235a888cee62",
    "WRITES_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skyline-pulse-production",
      "database_id": "ebaf7a80-ec0c-430c-a782-bae2cd427cb2",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "LOCAL_DEV": "false",
        "EMAIL_ENABLED": "false",
        "ACCESS_TEAM_DOMAIN": "peacockengr.cloudflareaccess.com",
        "ACCESS_AUD": "224a7b45baa6172859ee57072095451be938c73b9db9fe3d63fd56ce3495fc66"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "skyline-pulse-staging",
          "database_id": "2fed3452-8682-47d6-80a5-f230b4a9ce1e",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
